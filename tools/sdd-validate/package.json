{
  "name": "sdd-validate",
  "version": "0.1.0",
  "description": "Sensor computacional do harness SDD: valida a estrutura de specs (.sdd/specs/**) — IDs únicos, seções obrigatórias e rastreabilidade REQ↔APM↔Task.",
  "private": true,
  "type": "commonjs",
  "bin": {
    "sdd-validate": "./bin/sdd-validate.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test 'dist/tests/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
